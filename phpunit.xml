<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/pestphp/pest/preset/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Filament/Resources/*/Pages</directory>
        </exclude>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            DB de TESTING en PostgreSQL — separada de la DB local.
              · Local (lo que usamos a diario): olympo_ferreteria       → .env
              · Tests (RefreshDatabase la borra): olympo_ferreteria_test → aquí
            force="true" para que ni el .env ni una variable exportada en la
            terminal puedan apuntar los tests a la DB local. Además
            tests/TestCase.php aborta si el nombre de la DB no lleva "_test".
            Host y puerto NO van aquí: salen del .env (cada proyecto tiene su
            propio contenedor Postgres en su propio puerto).
            Crear la DB de tests (una sola vez):
                DB_DATABASE=olympo_ferreteria_test php artisan migrate   (responder Yes)
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="olympo_ferreteria_test" force="true"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="REDIS_CLIENT" value="predis"/>

        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="HORIZON_PATH" value="horizon"/>
    </php>
</phpunit>
